{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegisterAndDescribeTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": "arn:aws:ecs:us-east-2:357542025325:task-definition/aws-release-lab:*"
    },
    {
      "Sid": "UpdateAndDescribeECSService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:us-east-2:357542025325:service/aws-release-lab-cluster/aws-release-lab-service"
    },
    {
      "Sid": "PassExecutionRoleToECS",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::357542025325:role/ecsTaskExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
